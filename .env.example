# ============================================
# ShopGold AI Dashboard - Zmienne Środowiskowe
# ============================================
# Skopiuj ten plik jako .env i uzupełnij wartości

# --- AI Providers ---
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=AIza-your-gemini-key-here
AI_PROVIDER=openai

# --- ShopGold Connection ---
# Tryb połączenia: xml | csv | mysql
SHOPGOLD_CONNECTION_TYPE=xml

# Adres URL do XML feed (Ceneo lub inny)
SHOPGOLD_XML_FEED_URL=https://twojsklep.pl/xml/ceneo.xml

# Dane do panelu administracyjnego (do importu/eksportu przez panel)
SHOPGOLD_ADMIN_URL=https://twojsklep.pl/admin
SHOPGOLD_ADMIN_USER=admin
SHOPGOLD_ADMIN_PASS=haslo

# --- MySQL (tylko dla trybu mysql) ---
MYSQL_HOST=twojsklep.pl
MYSQL_PORT=3306
MYSQL_USER=db_user
MYSQL_PASS=db_password
MYSQL_DATABASE=shopgold_db
MYSQL_TABLE_PREFIX=sg_

# --- Aplikacja ---
PORT=3000
NODE_ENV=development
