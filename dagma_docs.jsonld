          },
          "hydra:title": "sendConfirmationEmailToBuyer",
          "hydra:required": false,
          "hydra:readable": true,
          "hydra:writeable": true,
          "hydra:description": "Czy wysłać wiadomość e-mail z potwierdzeniem złożenia zamówienia? E-mail zawiera wszystkie informacje zawarte w złożonym zamówieniu, natomiast nie zawiera danych zamawianej licencji, jaka powstanie w wyniku złożonego zamówienia.<br/>Wiadomość e-mail jest wysyłana na adres email przekazany w parametrze \"buyerContactPersonEmail\"."
        },
        {
          "@type": "hydra:SupportedProperty",
          "hydra:property": {
            "@id": "#Order:PreOrder/buyerContactPersonToInvoice",
