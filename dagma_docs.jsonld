          "hydra:writeable": true,
          "hydra:description": "Czy wysyłać e-mail z danymi licencji po jej zarejestrowaniu? Jest to ten sam e-mail, jaki po rejestracji każdej licencji imiennej jest wysyłany do partnera na adres przeznaczony do wysyłki kluczy licencyjnych."
        },
        {
          "@type": "hydra:SupportedProperty",
          "hydra:property": {
            "@id": "#Order:PreOrder/sendConfirmationEmailToBuyer",
