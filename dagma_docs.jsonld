          "hydra:readable": true,
          "hydra:writeable": false,
          "hydra:description": "Parametr informuje, czy dana czynność sprzedażowa, może zostać zaraportowania przez partnera po zarejestrowaniu projektu sprzedażowego."
        },
        {
          "@type": "hydra:SupportedProperty",
          "hydra:property": {
            "@id": "#Project:SalesActivity/checkSourceLicenseServiceExpirationDate",
