            "range": "xmls:boolean"
          },
          "hydra:title": "checkSourceLicenseServiceExpirationDate",
          "hydra:required": false,
          "hydra:readable": true,
          "hydra:writeable": true,
          "hydra:description": "Parametr informuje, czy dane działanie sprzedażowe może być raportowanie w określonym terminie przed końcem licencji źródłowej, której dotyczy dany projekt. Przykładowo, nie wcześniej niż na 60 dni przed końcem licencji źródłowej. Dokładny okres w jaki można raportować tak określone działanie, jest określony w parametrach \"checkSourceLicenseServiceExpirationDatePeriod\" oraz \"checkSourceLicenseServiceExpirationDateUnit\"."
        },
