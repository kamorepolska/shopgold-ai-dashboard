"<!DOCTYPE html>\n<html>\n    <head>\n        <meta charset=\"UTF-8\">\n        <title>Bifrost API - Dokumentacja - Logowanie</title>\n        <link rel=\"icon\" href=\"data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>\">\n            <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Source+Sans+Pro:ital,wght@0,200;0,300;0,400;0,600;0,700;0,900;1,200;1,300;1,400;1,600;1,700;1,900&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"/build/login.fc56100a.css\">\n\n                    <script src=\"/build/runtime.1fc5a464.js\"></script><script src=\"/build/app.281c4e16.js\"></script>\n            </head>\n    <body>\n            <div class=\"login-box\">\n        <div class=\"login-logo\">\n            <a href=\"/\">\n                <img src=\"/build/images/logo2.0e2ef06f.png\" alt=\"logo\" width=\"210\"/>\n            </a>\n        </div>\n        <div class=\"login-body\">\n            \n            <form action=\"/api/docs/login\" method=\"post\">\n                <div class=\"form-group\">\n                    <label for=\"username\">Login</label>\n                    <input class=\"form-control\" type=\"text\" id=\"username\" name=\"_username\" value=\"\" autocomplete=\"email\" required autofocus>\n                </div>\n                <div class=\"form-group\">\n                    <label for=\"password\">Hasło</label>\n                    <input class=\"form-control\" type=\"password\" id=\"password\" name=\"_password\" autocomplete=\"current-password\" required>\n                </div>\n                <input type=\"hidden\" name=\"_csrf_token\" value=\"32bd3991b675481d10ebbdb8197d9a0._jDk1ewxSGc_Kmy6WB-YxJE3UKUG8ZIrxn7nvxpVCZE.pHeAsL9AOVduciqIYHbTgPhQB99iov9hnxu-5VQATvvKWaGf2HM-NXQdJQ\">\n                <div class=\"clearfix\">\n                    <div class=\"form-group pull-left\">\n                        <button class=\"btn btn-primary\" type=\"submit\">Zaloguj się</button>\n                    </div>\n                </div>\n            </form>\n        </div>\n    </div>\n    </body>\n</html>\n"